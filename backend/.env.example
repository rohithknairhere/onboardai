# Copy to .env and adjust. Every option below is free.

# Which LLM backend to use: ollama | gemini | groq
LLM_PROVIDER=ollama

# Leave unset to use the provider's default model.
#   ollama -> qwen2.5:7b     gemini -> gemini-3.6-flash     groq -> llama-3.3-70b-versatile
# On a 4GB GPU, qwen2.5:3b is noticeably faster if 7b feels sluggish.
#
# Google retires Gemini models quickly, and the list endpoint still advertises
# retired ones (gemini-2.5-flash is listed but 404s). If a pinned model starts
# returning NOT_FOUND, use "gemini-flash-latest", which tracks the current one.
# LLM_MODEL=gemini-3.6-flash

# Only needed if LLM_PROVIDER=ollama and Ollama runs somewhere other than the default.
# OLLAMA_BASE_URL=http://localhost:11434

# Free-tier fallbacks. Only needed if you switch LLM_PROVIDER to one of these.
# GOOGLE_API_KEY=
# GROQ_API_KEY=
